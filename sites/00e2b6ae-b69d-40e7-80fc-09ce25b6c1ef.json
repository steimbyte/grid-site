{
  "id": "00e2b6ae-b69d-40e7-80fc-09ce25b6c1ef",
  "name": "sql-trainer",
  "content": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>SQL-Trainer | OSZ IMT</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/alasql@4/dist/alasql.min.js\"></script>\n    <style>\n        :root {\n            --bg: #121212;\n            --bg-light: #1e1e1e;\n            --bg-lighter: #2d2d2d;\n            --text: #e0e0e0;\n            --text-muted: #a0a0a0;\n            --accent: #4FC3F7;\n            --success: #4CAF50;\n            --error: #f44336;\n            --warning: #ff9800;\n            --border: #404040;\n        }\n\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n\n        body {\n            font-family: 'Segoe UI', 'Roboto', sans-serif;\n            background: var(--bg);\n            color: var(--text);\n            min-height: 100vh;\n        }\n\n        header {\n            background: var(--bg-light);\n            padding: 1rem 2rem;\n            border-bottom: 1px solid var(--border);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        header h1 { font-size: 1.5rem; color: var(--accent); }\n\n        .stats { display: flex; gap: 2rem; }\n        .stat { text-align: center; }\n        .stat-value { font-size: 1.5rem; font-weight: bold; color: var(--accent); }\n        .stat-label { font-size: 0.75rem; color: var(--text-muted); }\n\n        .main-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            height: calc(100vh - 70px);\n        }\n\n        /* LEFT: Schema */\n        .schema-panel {\n            background: var(--bg-light);\n            border-right: 1px solid var(--border);\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        .panel-header {\n            padding: 1rem;\n            border-bottom: 1px solid var(--border);\n        }\n\n        .panel-title { font-size: 1rem; color: var(--text-muted); }\n\n        .schema-content { flex: 1; padding: 1rem; overflow-y: auto; }\n\n        .mermaid { display: flex; justify-content: center; }\n\n        .table-info {\n            margin-top: 1rem;\n            padding: 1rem;\n            background: var(--bg);\n            border-radius: 8px;\n            font-size: 0.8rem;\n        }\n\n        .table-info h3 { color: var(--accent); margin-bottom: 0.5rem; }\n        .table-info code { color: var(--text-muted); line-height: 1.8; }\n\n        /* RIGHT: Tasks */\n        .task-panel {\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        .task-tabs {\n            display: flex;\n            background: var(--bg);\n            border-bottom: 1px solid var(--border);\n        }\n\n        .task-tab {\n            flex: 1;\n            padding: 0.75rem;\n            background: var(--bg);\n            border: none;\n            color: var(--text-muted);\n            cursor: pointer;\n            font-weight: bold;\n            border-bottom: 2px solid transparent;\n        }\n\n        .task-tab:hover { background: var(--bg-lighter); }\n        .task-tab.active { color: var(--text); border-bottom-color: var(--accent); }\n        .task-tab.easy.active { color: #81C784; border-bottom-color: #81C784; }\n        .task-tab.medium.active { color: #FFB74D; border-bottom-color: #FFB74D; }\n        .task-tab.hard.active { color: #E57373; border-bottom-color: #E57373; }\n\n        .task-list-container {\n            background: var(--bg-light);\n            padding: 0.75rem;\n            max-height: 150px;\n            overflow-y: auto;\n            border-bottom: 1px solid var(--border);\n        }\n\n        .task-list {\n            list-style: none;\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\n            gap: 0.4rem;\n        }\n\n        .task-item {\n            padding: 0.4rem 0.6rem;\n            background: var(--bg);\n            border-radius: 4px;\n            cursor: pointer;\n            border-left: 3px solid transparent;\n            font-size: 0.8rem;\n            transition: all 0.2s;\n        }\n\n        .task-item:hover { background: var(--bg-lighter); }\n        .task-item.active { border-left-color: var(--accent); background: var(--bg-lighter); }\n        .task-item.solved { border-left-color: var(--success); }\n        .task-item.solved::after { content: ' ✓'; color: var(--success); }\n        .task-item .task-id { font-weight: bold; color: var(--accent); }\n\n        /* Task Content */\n        .task-content {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            padding: 1rem;\n            overflow: hidden;\n        }\n\n        .task-description-box {\n            background: var(--bg-light);\n            border-radius: 8px;\n            padding: 0.75rem;\n            margin-bottom: 0.75rem;\n        }\n\n        .task-description-box h2 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n            color: var(--accent);\n        }\n\n        .task-description-box p { font-size: 0.9rem; line-height: 1.5; }\n\n        .editor-section {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            background: var(--bg-light);\n            border-radius: 8px;\n            overflow: hidden;\n        }\n\n        .editor-header {\n            padding: 0.5rem 1rem;\n            background: var(--bg);\n            border-bottom: 1px solid var(--border);\n            display: flex;\n            justify-content: space-between;\n            font-size: 0.8rem;\n            color: var(--text-muted);\n        }\n\n        kbd {\n            background: var(--bg-lighter);\n            padding: 0.15rem 0.4rem;\n            border-radius: 3px;\n            font-size: 0.75rem;\n        }\n\n        .sql-editor {\n            flex: 1;\n            width: 100%;\n            background: var(--bg);\n            border: none;\n            padding: 0.75rem;\n            font-family: 'Consolas', 'Monaco', monospace;\n            font-size: 0.85rem;\n            color: var(--text);\n            resize: none;\n        }\n\n        .sql-editor:focus { outline: none; }\n        .sql-editor::placeholder { color: var(--text-muted); }\n\n        .button-row {\n            display: flex;\n            gap: 0.5rem;\n            padding: 0.75rem;\n            background: var(--bg);\n            border-top: 1px solid var(--border);\n        }\n\n        button {\n            padding: 0.5rem 1rem;\n            border: none;\n            border-radius: 4px;\n            cursor: pointer;\n            font-weight: bold;\n            font-size: 0.85rem;\n            transition: all 0.2s;\n        }\n\n        .btn-primary { background: var(--accent); color: #000; }\n        .btn-primary:hover { background: #81D4FA; }\n        .btn-secondary { background: var(--bg-lighter); color: var(--text); }\n        .btn-secondary:hover { background: #3d3d3d; }\n        .btn-hint { background: var(--warning); color: #000; }\n\n        /* Feedback */\n        .feedback {\n            margin: 0.75rem 0;\n            padding: 0.75rem;\n            border-radius: 8px;\n            display: none;\n        }\n\n        .feedback.show { display: block; }\n        .feedback.success { background: rgba(76,175,80,0.2); border: 1px solid var(--success); }\n        .feedback.error { background: rgba(244,67,54,0.2); border: 1px solid var(--error); }\n        .feedback.warning { background: rgba(255,152,0,0.2); border: 1px solid var(--warning); }\n        .feedback h3 { margin-bottom: 0.25rem; }\n        .feedback.success h3 { color: var(--success); }\n        .feedback.error h3 { color: var(--error); }\n        .feedback.warning h3 { color: var(--warning); }\n\n        /* Result Table */\n        .result-section {\n            margin-top: 0.75rem;\n            background: var(--bg-light);\n            border-radius: 8px;\n            max-height: 200px;\n            overflow: hidden;\n            display: none;\n        }\n\n        .result-section.show { display: flex; flex-direction: column; }\n\n        .result-header {\n            padding: 0.5rem 1rem;\n            background: var(--bg);\n            font-size: 0.8rem;\n            color: var(--text-muted);\n            border-bottom: 1px solid var(--border);\n        }\n\n        .result-table-container {\n            flex: 1;\n            overflow: auto;\n        }\n\n        .result-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 0.8rem;\n        }\n\n        .result-table th {\n            background: var(--bg-lighter);\n            padding: 0.4rem 0.6rem;\n            text-align: left;\n            font-weight: bold;\n            position: sticky;\n            top: 0;\n        }\n\n        .result-table td {\n            padding: 0.3rem 0.6rem;\n            border-bottom: 1px solid var(--border);\n        }\n\n        .result-table tr:hover td { background: var(--bg-lighter); }\n\n        /* Solution */\n        .solution-block {\n            margin-top: 0.75rem;\n            background: var(--bg);\n            border-radius: 8px;\n            padding: 0.75rem;\n            display: none;\n        }\n\n        .solution-block.show { display: block; }\n        .solution-block h4 { color: var(--accent); margin-bottom: 0.5rem; font-size: 0.9rem; }\n        .solution-block pre { font-family: 'Consolas', monospace; font-size: 0.8rem; white-space: pre-wrap; }\n\n        @media (max-width: 900px) {\n            .main-container { grid-template-columns: 1fr; }\n            .schema-panel { max-height: 30vh; }\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>SQL-Trainer</h1>\n        <div class=\"stats\">\n            <div class=\"stat\"><div class=\"stat-value\" id=\"solved-count\">0</div><div class=\"stat-label\">Geloest</div></div>\n            <div class=\"stat\"><div class=\"stat-value\" id=\"total-count\">0</div><div class=\"stat-label\">Gesamt</div></div>\n        </div>\n    </header>\n\n    <div class=\"main-container\">\n        <!-- LEFT: Schema -->\n        <div class=\"schema-panel\">\n            <div class=\"panel-header\"><span class=\"panel-title\">Datenbankschema</span></div>\n            <div class=\"schema-content\">\n                <div class=\"mermaid\">\nerDiagram\n    T_Kunden ||--o{ T_Bestellungen : \"hat\"\n    T_Bestellungen ||--o{ T_Positionen : \"enthaelt\"\n    T_Artikel ||--o{ T_Positionen : \"in\"\n    T_MwSt ||--o{ T_Artikel : \"hat\"\n\n    T_Kunden {\n        int p_kunden_nr PK\n        string nachname\n        string vorname\n        string email\n        string plz\n        string stadt\n        string status\n    }\n\n    T_Bestellungen {\n        int p_bestell_nr PK\n        int f_kunden_nr FK\n        date bestelldatum\n        date lieferdatum\n        decimal gesamtbetrag\n    }\n\n    T_Positionen {\n        int p_pos_nr PK\n        int f_bestell_nr FK\n        int f_artikel_id FK\n        int menge\n        decimal kaufpreis\n    }\n\n    T_Artikel {\n        int p_artikel_nr PK\n        string bezeichnung\n        decimal listenpreis\n        string kategorie\n        string lagerplatz\n        int f_mwst_nr FK\n    }\n\n    T_MwSt {\n        int p_mwst_nr PK\n        decimal satz\n        string bezeichnung\n    }\n                </div>\n                <div class=\"table-info\">\n                    <h3>Tabellen:</h3>\n                    <code>\n                        T_Kunden (kunden_nr, nachname, vorname, email, plz, stadt, status)<br>\n                        T_Bestellungen (bestell_nr, kunden_nr, bestelldatum, lieferdatum, gesamtbetrag)<br>\n                        T_Positionen (pos_nr, bestell_nr, artikel_id, menge, kaufpreis)<br>\n                        T_Artikel (artikel_nr, bezeichnung, listenpreis, kategorie, lagerplatz, mwst_nr)<br>\n                        T_MwSt (mwst_nr, satz, bezeichnung)\n                    </code>\n                </div>\n            </div>\n        </div>\n\n        <!-- RIGHT: Tasks -->\n        <div class=\"task-panel\">\n            <div class=\"task-tabs\">\n                <button class=\"task-tab easy active\" data-filter=\"easy\">Leicht</button>\n                <button class=\"task-tab medium\" data-filter=\"medium\">Mittel</button>\n                <button class=\"task-tab hard\" data-filter=\"hard\">Schwer</button>\n            </div>\n\n            <div class=\"task-list-container\">\n                <ul class=\"task-list\" id=\"task-list\"></ul>\n            </div>\n\n            <div class=\"task-content\">\n                <div class=\"task-description-box\">\n                    <h2 id=\"task-title\">Waehle eine Aufgabe</h2>\n                    <p id=\"task-description\">Klicke auf eine Aufgabe in der Liste.</p>\n                </div>\n\n                <div class=\"editor-section\">\n                    <div class=\"editor-header\">\n                        <span>Deine SQL-Abfrage</span>\n                        <span><kbd>Ctrl</kbd>+<kbd>Enter</kbd> Ausfuehren</span>\n                    </div>\n                    <textarea class=\"sql-editor\" id=\"sql-input\" placeholder=\"SELECT ...\" spellcheck=\"false\"></textarea>\n                </div>\n\n                <div class=\"button-row\">\n                    <button class=\"btn-primary\" onclick=\"runSQL()\">Ausfuehren</button>\n                    <button class=\"btn-hint\" onclick=\"showHint()\">Hinweis</button>\n                    <button class=\"btn-secondary\" onclick=\"showSolution()\">Loesung</button>\n                    <button class=\"btn-secondary\" onclick=\"nextTask()\">Weiter ></button>\n                </div>\n\n                <div class=\"feedback\" id=\"feedback\"></div>\n\n                <div class=\"result-section\" id=\"result-section\">\n                    <div class=\"result-header\" id=\"result-header\">Ergebnis: 0 Zeilen</div>\n                    <div class=\"result-table-container\">\n                        <table class=\"result-table\" id=\"result-table\"></table>\n                    </div>\n                </div>\n\n                <div class=\"solution-block\" id=\"solution-block\">\n                    <h4>Musterloesung:</h4>\n                    <pre id=\"solution-code\"></pre>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Initialize Mermaid\n        mermaid.initialize({ startOnLoad: false, er: { diagramPadding: 20 } });\n        mermaid.run({ nodes: document.querySelectorAll('.mermaid') });\n\n        // ============================================\n        // DEMO-DATEN (AlaSQL)\n        // ============================================\n        const demoData = {\n            T_Kunden: [\n                { p_kunden_nr: 1, nachname: \"Mueller\", vorname: \"Anna\", email: \"anna@test.de\", plz: \"10115\", stadt: \"Berlin\", status: \"aktiv\" },\n                { p_kunden_nr: 2, nachname: \"Schmidt\", vorname: \"Tom\", email: \"tom@test.de\", plz: \"10115\", stadt: \"Berlin\", status: \"aktiv\" },\n                { p_kunden_nr: 3, nachname: \"Weber\", vorname: \"Lisa\", email: \"lisa@test.de\", plz: \"80331\", stadt: \"Muenchen\", status: \"aktiv\" },\n                { p_kunden_nr: 4, nachname: \"Fischer\", vorname: \"Max\", email: \"max@test.de\", plz: \"20095\", stadt: \"Hamburg\", status: \"inaktiv\" },\n                { p_kunden_nr: 5, nachname: \"Wagner\", vorname: \"Julia\", email: \"julia@test.de\", plz: \"10115\", stadt: \"Berlin\", status: \"aktiv\" }\n            ],\n            T_Bestellungen: [\n                { p_bestell_nr: 1001, f_kunden_nr: 1, bestelldatum: \"2025-01-15\", lieferdatum: \"2025-01-18\", gesamtbetrag: 299.99 },\n                { p_bestell_nr: 1002, f_kunden_nr: 1, bestelldatum: \"2025-02-20\", lieferdatum: null, gesamtbetrag: 149.50 },\n                { p_bestell_nr: 1003, f_kunden_nr: 2, bestelldatum: \"2025-01-10\", lieferdatum: \"2025-01-12\", gesamtbetrag: 89.99 },\n                { p_bestell_nr: 1004, f_kunden_nr: 3, bestelldatum: \"2025-03-05\", lieferdatum: \"2025-03-08\", gesamtbetrag: 599.00 },\n                { p_bestell_nr: 1005, f_kunden_nr: 5, bestelldatum: \"2025-02-28\", lieferdatum: null, gesamtbetrag: 45.00 }\n            ],\n            T_Artikel: [\n                { p_artikel_nr: 1, bezeichnung: \"Laptop Pro 15\", listenpreis: 999.99, kategorie: \"Elektronik\", lagerplatz: \"A-1-1\", f_mwst_nr: 1 },\n                { p_artikel_nr: 2, bezeichnung: \"Laptop Basic 14\", listenpreis: 599.00, kategorie: \"Elektronik\", lagerplatz: \"A-1-2\", f_mwst_nr: 1 },\n                { p_artikel_nr: 3, bezeichnung: \"USB-C Kabel\", listenpreis: 12.99, kategorie: \"Zubehoer\", lagerplatz: \"B-2-1\", f_mwst_nr: 1 },\n                { p_artikel_nr: 4, bezeichnung: \"Bluetooth Maus\", listenpreis: 29.99, kategorie: \"Zubehoer\", lagerplatz: \"B-2-2\", f_mwst_nr: 1 },\n                { p_artikel_nr: 5, bezeichnung: \"Gaming Tastatur\", listenpreis: 89.99, kategorie: \"Elektronik\", lagerplatz: \"A-2-1\", f_mwst_nr: 1 },\n                { p_artikel_nr: 6, bezeichnung: \"Monitor 27 Zoll\", listenpreis: 349.00, kategorie: \"Elektronik\", lagerplatz: \"A-3-1\", f_mwst_nr: 1 },\n                { p_artikel_nr: 7, bezeichnung: \"Schreibtischlampe LED\", listenpreis: 45.00, kategorie: \"Buero\", lagerplatz: \"C-1-1\", f_mwst_nr: 1 },\n                { p_artikel_nr: 8, bezeichnung: \"Notizblock A5\", listenpreis: 5.99, kategorie: \"Buero\", lagerplatz: \"C-2-1\", f_mwst_nr: 1 }\n            ],\n            T_Positionen: [\n                { p_pos_nr: 1, f_bestell_nr: 1001, f_artikel_id: 1, menge: 1, kaufpreis: 999.99 },\n                { p_pos_nr: 2, f_bestell_nr: 1001, f_artikel_id: 3, menge: 2, kaufpreis: 12.99 },\n                { p_pos_nr: 3, f_bestell_nr: 1002, f_artikel_id: 4, menge: 1, kaufpreis: 29.99 },\n                { p_pos_nr: 4, f_bestell_nr: 1002, f_artikel_id: 8, menge: 3, kaufpreis: 5.99 },\n                { p_pos_nr: 5, f_bestell_nr: 1003, f_artikel_id: 5, menge: 1, kaufpreis: 89.99 },\n                { p_pos_nr: 6, f_bestell_nr: 1004, f_artikel_nr: 1, menge: 1, kaufpreis: 999.99 },\n                { p_pos_nr: 7, f_bestell_nr: 1004, f_artikel_id: 6, menge: 1, kaufpreis: 349.00 },\n                { p_pos_nr: 8, f_bestell_nr: 1005, f_artikel_nr: 7, menge: 1, kaufpreis: 45.00 }\n            ],\n            T_MwSt: [\n                { p_mwst_nr: 1, satz: 19.00, bezeichnung: \"19%\" },\n                { p_mwst_nr: 2, satz: 7.00, bezeichnung: \"7%\" }\n            ]\n        };\n\n        // Initialize AlaSQL with demo data\n        function initAlaSQL() {\n            // Clear existing tables\n            alasql('DROP TABLE IF EXISTS T_Kunden');\n            alasql('DROP TABLE IF EXISTS T_Bestellungen');\n            alasql('DROP TABLE IF EXISTS T_Artikel');\n            alasql('DROP TABLE IF EXISTS T_Positionen');\n            alasql('DROP TABLE IF EXISTS T_MwSt');\n\n            // Create tables\n            alasql('CREATE TABLE T_Kunden (p_kunden_nr INT, nachname STRING, vorname STRING, email STRING, plz STRING, stadt STRING, status STRING)');\n            alasql('CREATE TABLE T_Bestellungen (p_bestell_nr INT, f_kunden_nr INT, bestelldatum STRING, lieferdatum STRING, gesamtbetrag DECIMAL)');\n            alasql('CREATE TABLE T_Artikel (p_artikel_nr INT, bezeichnung STRING, listenpreis DECIMAL, kategorie STRING, lagerplatz STRING, f_mwst_nr INT)');\n            alasql('CREATE TABLE T_Positionen (p_pos_nr INT, f_bestell_nr INT, f_artikel_id INT, menge INT, kaufpreis DECIMAL)');\n            alasql('CREATE TABLE T_MwSt (p_mwst_nr INT, satz DECIMAL, bezeichnung STRING)');\n\n            // Insert data\n            alasql.tables.T_Kunden.data = demoData.T_Kunden;\n            alasql.tables.T_Bestellungen.data = demoData.T_Bestellungen;\n            alasql.tables.T_Artikel.data = demoData.T_Artikel;\n            alasql.tables.T_Positionen.data = demoData.T_Positionen;\n            alasql.tables.T_MwSt.data = demoData.T_MwSt;\n        }\n\n        // Run SQL and show results\n        function runSQL() {\n            if (!currentTask) return showFeedback('warning', 'Waehle zuerst eine Aufgabe!');\n\n            const sql = document.getElementById('sql-input').value.trim();\n            if (!sql) return showFeedback('warning', 'Bitte SQL eingeben!');\n\n            try {\n                const results = alasql(sql);\n\n                // Display results\n                displayResults(results);\n\n                // Check if solution is correct\n                checkSolution(results);\n\n            } catch (err) {\n                showFeedback('error', 'SQL-Fehler: ' + err.message);\n                document.getElementById('result-section').classList.remove('show');\n            }\n        }\n\n        function displayResults(results) {\n            const section = document.getElementById('result-section');\n            const table = document.getElementById('result-table');\n            const header = document.getElementById('result-header');\n\n            section.classList.add('show');\n\n            if (!results || results.length === 0) {\n                table.innerHTML = '<tr><td>Keine Ergebnisse</td></tr>';\n                header.textContent = 'Ergebnis: 0 Zeilen';\n                return;\n            }\n\n            header.textContent = `Ergebnis: ${results.length} Zeile${results.length !== 1 ? 'n' : ''}`;\n\n            // Build table\n            const columns = Object.keys(results[0]);\n            let html = '<thead><tr>';\n            columns.forEach(col => {\n                html += `<th>${col}</th>`;\n            });\n            html += '</tr></thead><tbody>';\n\n            results.forEach(row => {\n                html += '<tr>';\n                columns.forEach(col => {\n                    let val = row[col];\n                    if (val === null || val === undefined) val = 'NULL';\n                    html += `<td>${val}</td>`;\n                });\n                html += '</tr>';\n            });\n            html += '</tbody>';\n\n            table.innerHTML = html;\n        }\n\n        function checkSolution(results) {\n            if (!currentTask || !results) return;\n\n            try {\n                const solution = currentTask.solution.trim();\n                const expectedResults = alasql(solution);\n\n                // Compare results\n                if (JSON.stringify(results) === JSON.stringify(expectedResults)) {\n                    markSolved();\n                    showFeedback('success', 'Richtig! Deine Abfrage liefert das richtige Ergebnis! 🎉');\n                } else if (results.length === expectedResults.length) {\n                    showFeedback('warning', 'Fast! Anzahl stimmt, aber Inhalt evtl. falsch.');\n                } else {\n                    showFeedback('error', `Falsch. Erwartet: ${expectedResults.length} Zeilen, erhalten: ${results.length} Zeilen.`);\n                }\n            } catch (err) {\n                // Solution might have different syntax, try keyword check\n                const sql = document.getElementById('sql-input').value.toUpperCase();\n                const missing = currentTask.keywords.filter(k => !sql.includes(k.toUpperCase()));\n                if (missing.length === 0) {\n                    markSolved();\n                    showFeedback('success', 'Loesung akzeptiert! ✓');\n                } else {\n                    showFeedback('error', `Fehlt: ${missing.join(', ')}`);\n                }\n            }\n        }\n\n        // ============================================\n        // AUFGABEN\n        // ============================================\n        const tasks = [\n            // LEICHT\n            { id: \"L1-01\", title: \"Alle Kunden\", difficulty: \"easy\", description: \"Zeige alle Kunden mit Vor- und Nachnamen.\", solution: \"SELECT vorname, nachname FROM T_Kunden\", keywords: [\"SELECT\", \"FROM\", \"T_KUNDEN\"] },\n            { id: \"L1-02\", title: \"Laptop finden\", difficulty: \"easy\", description: \"Zeige alle Artikel deren Bezeichnung mit 'Laptop' beginnt.\", solution: \"SELECT * FROM T_Artikel WHERE bezeichnung LIKE 'Laptop%'\", keywords: [\"SELECT\", \"WHERE\", \"LIKE\"] },\n            { id: \"L1-03\", title: \"Preis filtern\", difficulty: \"easy\", description: \"Welche Artikel kosten mehr als 100?\", solution: \"SELECT * FROM T_Artikel WHERE listenpreis > 100\", keywords: [\"WHERE\", \"LISTENPREIS\", \">\"] },\n            { id: \"L1-04\", title: \"Sortierung\", difficulty: \"easy\", description: \"Zeige alle Artikel sortiert nach Preis (guenstigste zuerst).\", solution: \"SELECT * FROM T_Artikel ORDER BY listenpreis\", keywords: [\"ORDER BY\", \"LISTENPREIS\"] },\n            { id: \"L1-05\", title: \"Offene Bestellungen\", difficulty: \"easy\", description: \"Welche Bestellungen sind noch nicht geliefert?\", solution: \"SELECT * FROM T_Bestellungen WHERE lieferdatum IS NULL\", keywords: [\"IS NULL\"] },\n            { id: \"L1-06\", title: \"Anzahl zaehlen\", difficulty: \"easy\", description: \"Wie viele Kunden gibt es?\", solution: \"SELECT COUNT(*) AS anzahl FROM T_Kunden\", keywords: [\"COUNT\"] },\n            { id: \"L1-07\", title: \"MwSt-Sätze\", difficulty: \"easy\", description: \"Zeige alle verschiedenen MwSt-Saetze.\", solution: \"SELECT DISTINCT satz FROM T_MwSt\", keywords: [\"DISTINCT\"] },\n            { id: \"L1-08\", title: \"NULL ersetzen\", difficulty: \"easy\", description: \"Zeige alle Bestellungen mit Lieferdatum oder 'ausstehend'.\", solution: \"SELECT p_bestell_nr, COALESCE(lieferdatum, 'ausstehend') AS status FROM T_Bestellungen\", keywords: [\"COALESCE\"] },\n            { id: \"L1-09\", title: \"Top 3 teuerste\", difficulty: \"easy\", description: \"Zeige die 3 teuersten Artikel.\", solution: \"SELECT * FROM T_Artikel ORDER BY listenpreis DESC LIMIT 3\", keywords: [\"ORDER BY\", \"DESC\", \"LIMIT\"] },\n\n            // MITTEL\n            { id: \"M2-01\", title: \"Kunde + Bestellungen\", difficulty: \"medium\", description: \"Zeige Nachname und Bestelldatum.\", solution: \"SELECT k.nachname, b.bestelldatum FROM T_Kunden k JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr\", keywords: [\"JOIN\", \"ON\"] },\n            { id: \"M2-02\", title: \"Kunden ohne Bestellung\", difficulty: \"medium\", description: \"Welche Kunden haben noch nie bestellt?\", solution: \"SELECT k.nachname FROM T_Kunden k LEFT JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr WHERE b.p_bestell_nr IS NULL\", keywords: [\"LEFT JOIN\", \"WHERE\", \"IS NULL\"] },\n            { id: \"M2-03\", title: \"Bestellungen pro Kunde\", difficulty: \"medium\", description: \"Zeige jeden Kunden mit Anzahl Bestellungen.\", solution: \"SELECT k.nachname, COUNT(b.p_bestell_nr) AS anzahl FROM T_Kunden k LEFT JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr GROUP BY k.nachname\", keywords: [\"GROUP BY\", \"COUNT\"] },\n            { id: \"M2-04\", title: \"Umsatz pro Kunde\", difficulty: \"medium\", description: \"Berechne den Gesamtumsatz pro Kunde.\", solution: \"SELECT k.nachname, SUM(b.gesamtbetrag) AS umsatz FROM T_Kunden k LEFT JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr GROUP BY k.nachname\", keywords: [\"SUM\", \"GROUP BY\"] },\n            { id: \"M2-05\", title: \"Artikel + MwSt\", difficulty: \"medium\", description: \"Zeige Artikel mit MwSt-Satz.\", solution: \"SELECT a.bezeichnung, a.listenpreis, m.satz FROM T_Artikel a JOIN T_MwSt m ON a.f_mwst_nr = m.p_mwst_nr\", keywords: [\"JOIN\", \"ON\"] },\n            { id: \"M2-06\", title: \"Statistik pro Lager\", difficulty: \"medium\", description: \"Zeige pro Lagerplatz min/max/avg Preis.\", solution: \"SELECT lagerplatz, MIN(listenpreis) AS min_preis, MAX(listenpreis) AS max_preis, AVG(listenpreis) AS avg_preis FROM T_Artikel GROUP BY lagerplatz\", keywords: [\"GROUP BY\", \"MIN\", \"MAX\", \"AVG\"] },\n            { id: \"M2-07\", title: \"Kategorien filtern\", difficulty: \"medium\", description: \"Welche Kategorien haben mehr als 2 Artikel?\", solution: \"SELECT kategorie, COUNT(*) AS anzahl FROM T_Artikel GROUP BY kategorie HAVING COUNT(*) > 2\", keywords: [\"GROUP BY\", \"HAVING\"] },\n            { id: \"M2-08\", title: \"Positionen + Artikel\", difficulty: \"medium\", description: \"Zeige jede Position mit Artikelname.\", solution: \"SELECT p.f_bestell_nr, a.bezeichnung, p.menge FROM T_Positionen p JOIN T_Artikel a ON p.f_artikel_id = a.p_artikel_nr\", keywords: [\"JOIN\", \"ON\"] },\n            { id: \"M2-09\", title: \"Doppelte PLZ\", difficulty: \"medium\", description: \"Welche PLZ haben mehr als 1 Kunden?\", solution: \"SELECT plz, COUNT(*) AS anzahl FROM T_Kunden GROUP BY plz HAVING COUNT(*) > 1\", keywords: [\"GROUP BY\", \"HAVING\"] },\n            { id: \"M2-10\", title: \"Kunde + Positionen\", difficulty: \"medium\", description: \"Zeige Kundenname und bestellte Artikel.\", solution: \"SELECT k.nachname, a.bezeichnung FROM T_Kunden k JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr JOIN T_Positionen p ON b.p_bestell_nr = p.f_bestell_nr JOIN T_Artikel a ON p.f_artikel_id = a.p_artikel_nr\", keywords: [\"JOIN\", \"JOIN\"] },\n\n            // SCHWER\n            { id: \"S3-01\", title: \"Monatlicher Umsatz\", difficulty: \"hard\", description: \"Zeige Umsatz pro Monat.\", solution: \"SELECT SUBSTR(bestelldatum, 1, 7) AS monat, SUM(gesamtbetrag) AS umsatz FROM T_Bestellungen GROUP BY SUBSTR(bestelldatum, 1, 7)\", keywords: [\"SUBSTR\", \"GROUP BY\", \"SUM\"] },\n            { id: \"S3-02\", title: \"Top Kunde\", difficulty: \"hard\", description: \"Welcher Kunde hat am meisten bestellt?\", solution: \"SELECT k.nachname, SUM(b.gesamtbetrag) AS umsatz FROM T_Kunden k JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr GROUP BY k.nachname ORDER BY umsatz DESC LIMIT 1\", keywords: [\"ORDER BY\", \"DESC\", \"LIMIT\"] },\n            { id: \"S3-03\", title: \"Teuerste pro Kat.\", difficulty: \"hard\", description: \"Zeige den teuersten Artikel jeder Kategorie.\", solution: \"SELECT kategorie, MAX(listenpreis) AS max_preis FROM T_Artikel GROUP BY kategorie\", keywords: [\"GROUP BY\", \"MAX\"] },\n            { id: \"S3-04\", title: \"Lieferzeit-Analyse\", difficulty: \"hard\", description: \"Wie viele Tage dauert die Lieferung (Durchschnitt)?\", solution: \"SELECT AVG(JULIANDAY(lieferdatum) - JULIANDAY(bestelldatum)) AS tage FROM T_Bestellungen WHERE lieferdatum IS NOT NULL\", keywords: [\"AVG\", \"JULIANDAY\"] },\n            { id: \"S3-05\", title: \"Cross-Selling\", difficulty: \"hard\", description: \"Welche Artikel werden oft zusammen mit Artikel 1 gekauft?\", solution: \"SELECT a2.bezeichnung, COUNT(*) AS anzahl FROM T_Positionen p1 JOIN T_Positionen p2 ON p1.f_bestell_nr = p2.f_bestell_nr AND p1.f_artikel_id != p2.f_artikel_id JOIN T_Artikel a2 ON p2.f_artikel_id = a2.p_artikel_nr WHERE p1.f_artikel_id = 1 GROUP BY a2.bezeichnung\", keywords: [\"JOIN\", \"WHERE\", \"GROUP BY\"] },\n            { id: \"S3-06\", title: \"Warenkorb-Groesse\", difficulty: \"hard\", description: \"Wie viele Artikel pro Bestellung (Durchschnitt)?\", solution: \"SELECT AVG(anzahl) AS durchschnitt FROM (SELECT f_bestell_nr, COUNT(*) AS anzahl FROM T_Positionen GROUP BY f_bestell_nr)\", keywords: [\"AVG\", \"SELECT\"] },\n            { id: \"S3-07\", title: \"Stammkunden\", difficulty: \"hard\", description: \"Kunden mit mehr als 1 Bestellung?\", solution: \"SELECT k.nachname, COUNT(b.p_bestell_nr) AS anzahl FROM T_Kunden k JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr GROUP BY k.nachname HAVING COUNT(*) > 1\", keywords: [\"GROUP BY\", \"HAVING\", \"COUNT\"] },\n            { id: \"S3-08\", title: \"Umsatz-Status\", difficulty: \"hard\", description: \"Zeige Kunden mit aktuellem Status.\", solution: \"SELECT k.nachname, k.status, COALESCE(SUM(b.gesamtbetrag), 0) AS umsatz FROM T_Kunden k LEFT JOIN T_Bestellungen b ON k.p_kunden_nr = b.f_kunden_nr GROUP BY k.nachname, k.status\", keywords: [\"LEFT JOIN\", \"GROUP BY\", \"COALESCE\"] }\n        ];\n\n        let currentTask = null;\n        let solvedTasks = new Set(JSON.parse(localStorage.getItem('solvedTasks') || '[]'));\n        let currentFilter = 'easy';\n\n        function init() {\n            initAlaSQL();\n            renderTaskList();\n            updateStats();\n\n            document.getElementById('sql-input').addEventListener('keydown', (e) => {\n                if (e.ctrlKey && e.key === 'Enter') runSQL();\n            });\n\n            document.querySelectorAll('.task-tab').forEach(tab => {\n                tab.addEventListener('click', () => {\n                    document.querySelectorAll('.task-tab').forEach(t => t.classList.remove('active'));\n                    tab.classList.add('active');\n                    currentFilter = tab.dataset.filter;\n                    renderTaskList();\n                });\n            });\n        }\n\n        function renderTaskList() {\n            const list = document.getElementById('task-list');\n            const filtered = tasks.filter(t => t.difficulty === currentFilter);\n            list.innerHTML = filtered.map(t => `\n                <li class=\"task-item ${solvedTasks.has(t.id) ? 'solved' : ''} ${currentTask?.id === t.id ? 'active' : ''}\" onclick=\"selectTask('${t.id}')\">\n                    <span class=\"task-id\">${t.id}</span> ${t.title}\n                </li>\n            `).join('');\n        }\n\n        function selectTask(id) {\n            currentTask = tasks.find(t => t.id === id);\n            document.getElementById('task-title').textContent = `${currentTask.id}: ${currentTask.title}`;\n            document.getElementById('task-description').textContent = currentTask.description;\n            document.getElementById('sql-input').value = '';\n            document.getElementById('feedback').className = 'feedback';\n            document.getElementById('feedback').style.display = 'none';\n            document.getElementById('result-section').classList.remove('show');\n            document.getElementById('solution-block').classList.remove('show');\n            renderTaskList();\n        }\n\n        function markSolved() {\n            solvedTasks.add(currentTask.id);\n            localStorage.setItem('solvedTasks', JSON.stringify([...solvedTasks]));\n            updateStats();\n            renderTaskList();\n        }\n\n        function updateStats() {\n            document.getElementById('solved-count').textContent = solvedTasks.size;\n            document.getElementById('total-count').textContent = tasks.length;\n        }\n\n        function showFeedback(type, msg) {\n            const f = document.getElementById('feedback');\n            const icons = { success: '✓', error: '✗', warning: '!' };\n            const titles = { success: 'Erfolg', error: 'Fehler', warning: 'Hinweis' };\n            f.className = `feedback show ${type}`;\n            f.innerHTML = `<h3>${icons[type]} ${titles[type]}</h3><p>${msg}</p>`;\n        }\n\n        function showHint() {\n            if (!currentTask) return;\n            const hints = {\n                L1: \"Nutze SELECT ... FROM ... und ggf. WHERE\",\n                L2: \"LIKE mit % als Platzhalter\",\n                L3: \"Vergleichsoperator > in WHERE\",\n                L4: \"ORDER BY sortiert Ergebnisse\",\n                L5: \"IS NULL findet leere Werte\",\n                L6: \"COUNT(*) zaehlt alle Zeilen\",\n                M1: \"JOIN verbindet zwei Tabellen\",\n                M2: \"LEFT JOIN zeigt auch NULL\",\n                M3: \"GROUP BY gruppiert, COUNT zaehlt\",\n                H1: \"SUBSTR oder LIKE fuer Datumsteile\",\n                default: \"Versuche es Schritt fuer Schritt\"\n            };\n            showFeedback('warning', hints[currentTask.id.substring(0,2)] || hints.default);\n        }\n\n        function showSolution() {\n            if (!currentTask) return;\n            document.getElementById('solution-code').textContent = currentTask.solution;\n            document.getElementById('solution-block').classList.add('show');\n        }\n\n        function nextTask() {\n            if (!currentTask) return selectTask(tasks.find(t => t.difficulty === currentFilter).id);\n            const same = tasks.filter(t => t.difficulty === currentFilter);\n            const next = same[(same.findIndex(t => t.id === currentTask.id) + 1) % same.length];\n            selectTask(next.id);\n        }\n\n        init();\n    </script>\n</body>\n</html>\n",
