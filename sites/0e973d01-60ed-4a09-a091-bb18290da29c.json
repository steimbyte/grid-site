{
  "id": "0e973d01-60ed-4a09-a091-bb18290da29c",
  "name": "LWL",
  "content": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>LWL-Steckertypen Trainer</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\"></script>\n  <style>\n    :root {\n      --accent: #c9a227;\n      --glow: rgba(201, 162, 39, 0.4);\n      --accent-warm: #a88520;\n      --bg-accent-tint: rgba(201, 162, 39, 0.06);\n      --cursor-glow: rgba(201, 162, 39, 0.4);\n      \n      --bg-deep: #0a0a0f;\n      --bg-surface: #12121a;\n      --bg-elevated: #1a1a24;\n      --glass: rgba(255, 255, 255, 0.05);\n      --glass-light: rgba(255, 255, 255, 0.08);\n      --glass-tint: rgba(201, 162, 39, 0.12);\n      --border: rgba(255, 255, 255, 0.1);\n      --border-accent: rgba(201, 162, 39, 0.4);\n      --text-bright: #ffffff;\n      --text-primary: #e8e8f0;\n      --text-muted: rgba(255, 255, 255, 0.5);\n      \n      --radius-sm: 8px;\n      --radius-md: 12px;\n      --radius-lg: 16px;\n      --radius-xl: 20px;\n      --transition-fast: 150ms;\n      --transition-normal: 300ms;\n      --ease-out: cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: 'Space Grotesk', system-ui, sans-serif;\n      background: var(--bg-deep);\n      color: var(--text-primary);\n      min-height: 100vh;\n      overflow-x: hidden;\n    }\n\n    .cursor-glow {\n      position: fixed;\n      width: 400px;\n      height: 400px;\n      border-radius: 50%;\n      background: radial-gradient(circle, var(--cursor-glow), transparent 70%);\n      transform: translate3d(-50%, -50%, 0);\n      pointer-events: none;\n      contain: layout paint;\n      will-change: transform;\n      opacity: 0.5;\n      mix-blend-mode: screen;\n      z-index: 9999;\n    }\n\n    .noise-bg {\n      position: fixed;\n      inset: 0;\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\");\n      opacity: 0.03;\n      pointer-events: none;\n      z-index: 1;\n    }\n\n    .orb {\n      position: fixed;\n      border-radius: 50%;\n      filter: blur(80px);\n      pointer-events: none;\n      z-index: 0;\n    }\n\n    .orb-1 {\n      width: 400px;\n      height: 400px;\n      background: radial-gradient(circle, rgba(201, 162, 39, 0.15), transparent 70%);\n      top: -100px;\n      right: -100px;\n    }\n\n    .orb-2 {\n      width: 300px;\n      height: 300px;\n      background: radial-gradient(circle, rgba(90, 138, 106, 0.1), transparent 70%);\n      bottom: -50px;\n      left: -50px;\n    }\n\n    .container {\n      position: relative;\n      z-index: 10;\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 2rem;\n      padding-left: max(40px, 7vw);\n    }\n\n    header {\n      text-align: center;\n      margin-bottom: 3rem;\n      padding-top: 2rem;\n    }\n\n    h1 {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-size: clamp(1.75rem, 4vw, 2.5rem);\n      font-weight: 700;\n      color: var(--text-bright);\n      margin-bottom: 0.5rem;\n    }\n\n    .subtitle {\n      color: var(--text-muted);\n      font-size: 1rem;\n    }\n\n    .difficulty-tabs {\n      display: flex;\n      justify-content: center;\n      gap: 0.75rem;\n      margin-bottom: 2rem;\n      flex-wrap: wrap;\n    }\n\n    .tab-btn {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-weight: 600;\n      font-size: 0.875rem;\n      padding: 0.75rem 1.5rem;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-full);\n      background: var(--glass);\n      color: var(--text-muted);\n      cursor: pointer;\n      transition: all var(--transition-normal) var(--ease-out);\n    }\n\n    .tab-btn:hover {\n      background: var(--glass-light);\n      color: var(--text-primary);\n    }\n\n    .tab-btn.active {\n      background: var(--glass-tint);\n      border-color: var(--border-accent);\n      color: var(--accent);\n      box-shadow: 0 0 20px var(--glow);\n    }\n\n    .quiz-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));\n      gap: 1.5rem;\n    }\n\n    .quiz-card {\n      background: var(--glass);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border: 1px solid var(--border);\n      border-radius: var(--radius-lg);\n      padding: 1.5rem;\n      transition: all var(--transition-normal) var(--ease-out);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .quiz-card::before {\n      content: '';\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      background: linear-gradient(135deg, var(--accent), transparent 50%);\n      opacity: 0;\n      transition: opacity var(--transition-normal);\n      pointer-events: none;\n    }\n\n    .quiz-card:hover {\n      background: var(--glass-light);\n      border-color: var(--border-accent);\n      transform: translateY(-2px);\n      box-shadow: 0 8px 32px var(--glow);\n    }\n\n    .quiz-card:hover::before {\n      opacity: 0.05;\n    }\n\n    .card-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 1rem;\n    }\n\n    .badge {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-size: 0.65rem;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 0.25rem 0.75rem;\n      border-radius: var(--radius-full);\n      background: var(--glass-tint);\n      color: var(--accent);\n      border: 1px solid var(--border-accent);\n    }\n\n    .badge.true-false {\n      background: rgba(90, 138, 106, 0.15);\n      color: #5a8a6a;\n      border-color: rgba(90, 138, 106, 0.4);\n    }\n\n    .badge.multiple-choice {\n      background: rgba(64, 128, 192, 0.15);\n      color: #4080c0;\n      border-color: rgba(64, 128, 192, 0.4);\n    }\n\n    .card-icon {\n      color: var(--text-muted);\n    }\n\n    .question-text {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-size: 1rem;\n      font-weight: 500;\n      color: var(--text-bright);\n      margin-bottom: 1.25rem;\n      line-height: 1.5;\n    }\n\n    .options {\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n    }\n\n    .option-btn {\n      font-family: 'Space Grotesk', system-ui, sans-serif;\n      font-size: 0.875rem;\n      padding: 0.75rem 1rem;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-md);\n      background: var(--glass);\n      color: var(--text-primary);\n      cursor: pointer;\n      text-align: left;\n      transition: all var(--transition-fast) var(--ease-out);\n      position: relative;\n    }\n\n    .option-btn:hover:not(:disabled) {\n      background: var(--glass-light);\n      border-color: var(--border-accent);\n    }\n\n    .option-btn.selected {\n      background: var(--glass-tint);\n      border-color: var(--accent);\n      color: var(--accent);\n    }\n\n    .option-btn.correct {\n      background: rgba(90, 138, 106, 0.2);\n      border-color: #5a8a6a;\n      color: #5a8a6a;\n    }\n\n    .option-btn.incorrect {\n      background: rgba(192, 64, 64, 0.2);\n      border-color: #c04040;\n      color: #c04040;\n    }\n\n    .option-btn:disabled {\n      cursor: default;\n    }\n\n    .option-label {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 1.5rem;\n      height: 1.5rem;\n      border-radius: 50%;\n      background: var(--glass-light);\n      margin-right: 0.75rem;\n      font-weight: 600;\n      font-size: 0.75rem;\n    }\n\n    .true-false-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 0.75rem;\n    }\n\n    .tf-btn {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-weight: 600;\n      font-size: 1rem;\n      padding: 1.25rem;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-md);\n      background: var(--glass);\n      cursor: pointer;\n      transition: all var(--transition-fast) var(--ease-out);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 0.5rem;\n    }\n\n    .tf-btn:hover:not(:disabled) {\n      background: var(--glass-light);\n      border-color: var(--border-accent);\n    }\n\n    .tf-btn.selected-true {\n      background: rgba(90, 138, 106, 0.2);\n      border-color: #5a8a6a;\n      color: #5a8a6a;\n    }\n\n    .tf-btn.selected-false {\n      background: rgba(192, 64, 64, 0.2);\n      border-color: #c04040;\n      color: #c04040;\n    }\n\n    .tf-btn.correct {\n      background: rgba(90, 138, 106, 0.2);\n      border-color: #5a8a6a;\n      color: #5a8a6a;\n    }\n\n    .tf-btn.incorrect {\n      background: rgba(192, 64, 64, 0.2);\n      border-color: #c04040;\n      color: #c04040;\n    }\n\n    .tf-btn:disabled {\n      cursor: default;\n    }\n\n    .tf-btn [data-lucide] {\n      width: 24px;\n      height: 24px;\n    }\n\n    .check-answer-btn {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-weight: 600;\n      font-size: 0.875rem;\n      width: 100%;\n      margin-top: 1rem;\n      padding: 0.75rem;\n      border: 1px solid var(--border-accent);\n      border-radius: var(--radius-md);\n      background: var(--glass-tint);\n      color: var(--accent);\n      cursor: pointer;\n      transition: all var(--transition-fast) var(--ease-out);\n    }\n\n    .check-answer-btn:hover:not(:disabled) {\n      background: var(--accent);\n      color: var(--bg-deep);\n    }\n\n    .check-answer-btn:disabled {\n      opacity: 0.5;\n      cursor: default;\n    }\n\n    .feedback {\n      margin-top: 0.75rem;\n      padding: 0.75rem;\n      border-radius: var(--radius-md);\n      font-size: 0.8rem;\n      display: none;\n    }\n\n    .feedback.show {\n      display: block;\n    }\n\n    .feedback.correct {\n      background: rgba(90, 138, 106, 0.1);\n      border: 1px solid rgba(90, 138, 106, 0.3);\n      color: #5a8a6a;\n    }\n\n    .feedback.incorrect {\n      background: rgba(192, 64, 64, 0.1);\n      border: 1px solid rgba(192, 64, 64, 0.3);\n      color: #c04040;\n    }\n\n    .progress-bar {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: 3px;\n      background: var(--bg-surface);\n      z-index: 1000;\n    }\n\n    .progress-fill {\n      height: 100%;\n      background: var(--accent);\n      transition: width var(--transition-normal) var(--ease-out);\n      box-shadow: 0 0 10px var(--glow);\n    }\n\n    .score-display {\n      position: fixed;\n      top: 1rem;\n      right: 1rem;\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-weight: 600;\n      font-size: 1rem;\n      padding: 0.5rem 1rem;\n      background: var(--glass);\n      border: 1px solid var(--border-accent);\n      border-radius: var(--radius-full);\n      color: var(--accent);\n      backdrop-filter: blur(10px);\n      z-index: 1000;\n    }\n\n    .separator {\n      height: 1px;\n      background: linear-gradient(90deg, transparent, var(--border-accent), transparent);\n      margin: 2rem 0;\n    }\n\n    .stats-row {\n      display: flex;\n      justify-content: center;\n      gap: 2rem;\n      margin-bottom: 2rem;\n      flex-wrap: wrap;\n    }\n\n    .stat-item {\n      text-align: center;\n    }\n\n    .stat-value {\n      font-family: 'Outfit', system-ui, sans-serif;\n      font-size: 2rem;\n      font-weight: 700;\n      color: var(--accent);\n    }\n\n    .stat-label {\n      font-size: 0.75rem;\n      color: var(--text-muted);\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n\n    @media (max-width: 768px) {\n      .quiz-grid {\n        grid-template-columns: 1fr;\n      }\n      \n      .container {\n        padding: 1rem;\n        padding-left: 1rem;\n      }\n\n      .score-display {\n        position: static;\n        margin: 0 auto 1rem;\n        text-align: center;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.01ms !important;\n      }\n    }\n\n    [data-lucide] {\n      width: 1em;\n      height: 1em;\n      stroke: currentColor;\n      stroke-width: 2;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      fill: none;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"cursor-glow\" id=\"cursorGlow\"></div>\n  <div class=\"noise-bg\"></div>\n  <div class=\"orb orb-1\"></div>\n  <div class=\"orb orb-2\"></div>\n  \n  <div class=\"progress-bar\">\n    <div class=\"progress-fill\" id=\"progressFill\" style=\"width: 0%\"></div>\n  </div>\n\n  <div class=\"score-display\">\n    <span id=\"scoreDisplay\">0 / 0</span>\n  </div>\n\n  <div class=\"container\">\n    <header>\n      <h1>🔌 LWL-Steckertypen Trainer</h1>\n      <p class=\"subtitle\">Teste dein Wissen über Glasfaser-Steckverbinder</p>\n    </header>\n\n    <div class=\"stats-row\">\n      <div class=\"stat-item\">\n        <div class=\"stat-value\" id=\"correctCount\">0</div>\n        <div class=\"stat-label\">Richtig</div>\n      </div>\n      <div class=\"stat-item\">\n        <div class=\"stat-value\" id=\"incorrectCount\">0</div>\n        <div class=\"stat-label\">Falsch</div>\n      </div>\n      <div class=\"stat-item\">\n        <div class=\"stat-value\" id=\"totalAnswered\">0</div>\n        <div class=\"stat-label\">Beantwortet</div>\n      </div>\n    </div>\n\n    <div class=\"difficulty-tabs\">\n      <button class=\"tab-btn active\" data-difficulty=\"easy\">🌱 Einfach</button>\n      <button class=\"tab-btn\" data-difficulty=\"medium\">⚡ Mittel</button>\n      <button class=\"tab-btn\" data-difficulty=\"hard\">🔥 Schwer</button>\n    </div>\n\n    <div class=\"separator\"></div>\n\n    <div class=\"quiz-grid\" id=\"quizGrid\"></div>\n  </div>\n\n  <script>\n    // Cursor Glow Effect\n    const cursorGlow = document.getElementById('cursorGlow');\n    document.addEventListener('mousemove', (e) => {\n      cursorGlow.style.left = e.clientX + 'px';\n      cursorGlow.style.top = e.clientY + 'px';\n    });\n\n    // Quiz Data\n    const quizData = {\n      easy: [\n        {\n          id: 'e1',\n          type: 'true-false',\n          question: 'Der LC-Stecker ist der am häufigsten verwendete LWL-Steckertyp in Rechenzentren.',\n          answer: true,\n          explanation: 'Der LC-Stecker ist mit Abstand der Marktführer in modernen Rechenzentren dank seiner kompakten 1,25mm Ferrule.'\n        },\n        {\n          id: 'e2',\n          type: 'multiple-choice',\n          question: 'Welche Ferrule-Größe hat der SC-Stecker?',\n          options: ['1,25 mm', '2,5 mm', 'MT-Type (Mehrfaser)', '4,0 mm'],\n          correct: 1,\n          explanation: 'Der SC-Stecker verwendet eine 2,5mm Ferrule, wie auch FC und ST.'\n        },\n        {\n          id: 'e3',\n          type: 'true-false',\n          question: 'Singlemode-Fasern werden für lange Übertragungsstrecken verwendet.',\n          answer: true,\n          explanation: 'Singlemode (OS2) ist für Strecken von mehreren Kilometern geeignet, während Multimode nur für kurze Distanzen gedacht ist.'\n        },\n        {\n          id: 'e4',\n          type: 'multiple-choice',\n          question: 'Was bedeutet die Abkürzung \"LC\"?',\n          options: ['Long Connector', 'Lucent Connector', 'Large Core', 'Local Connector'],\n          correct: 1,\n          explanation: 'LC steht für \"Lucent Connector\" - benannt nach der Firma Lucent Technologies.'\n        },\n        {\n          id: 'e5',\n          type: 'true-false',\n          question: 'MPO-Stecker können nur eine einzelne Faser aufnehmen.',\n          answer: false,\n          explanation: 'MPO-Stecker sind Mehrfaser-Steckverbinder und können 12, 24 oder sogar mehr Fasern gleichzeitig aufnehmen.'\n        },\n        {\n          id: 'e6',\n          type: 'multiple-choice',\n          question: 'Welcher Steckertyp verwendet ein Bajonett-Verschluss-System?',\n          options: ['FC', 'SC', 'ST', 'MPO'],\n          correct: 2,\n          explanation: 'Der ST-Stecker (Straight Tip) verwendet ein Bajonett-Verschluss-System zum schnellen Einrasten.'\n        },\n        {\n          id: 'e7',\n          type: 'true-false',\n          question: 'APC-Politur (8°) wird hauptsächlich bei Singlemode-Steckern verwendet.',\n          answer: true,\n          explanation: 'APC (Angled Physical Contact) mit 8° Schrägschliff sorgt für minimale Reflexionen und wird bei Singlemode eingesetzt.'\n        },\n        {\n          id: 'e8',\n          type: 'multiple-choice',\n          question: 'Welche Farbe kennzeichnet typischerweise einen Multimode-Stecker (OM3/OM4)?',\n          options: ['Grün (APC)', 'Blau (UPC)', 'Beige (Legacy)', 'Schwarz'],\n          correct: 1,\n          explanation: 'Blaue Stecker kennzeichnen UPC-Politur, die Standard bei Multimode ist. Grün = APC (Singlemode).'\n        }\n      ],\n      medium: [\n        {\n          id: 'm1',\n          type: 'multiple-choice',\n          question: 'Wie viele Fasern kann ein Standard MPO-12 Stecker maximal aufnehmen?',\n          options: ['4 Fasern', '8 Fasern', '12 Fasern', '24 Fasern'],\n          correct: 2,\n          explanation: 'MPO-12 hat 12 Faserpositionen (6 Fasern pro Reihe, 2 Reihen).'\n        },\n        {\n          id: 'm2',\n          type: 'true-false',\n          question: 'Der E2000-Stecker hat einen integrierten automatischen Shutter zum Laserschutz.',\n          answer: true,\n          explanation: 'E2000 ist der einzige Steckertyp mit automatischem Shutter - ein wichtiger Sicherheitsvorteil.'\n        },\n        {\n          id: 'm3',\n          type: 'multiple-choice',\n          question: 'Welcher Steckertyp wird hauptsächlich in der Messtechnik und Kalibrierung verwendet?',\n          options: ['LC', 'SC', 'FC', 'ST'],\n          correct: 2,\n          explanation: 'Der FC-Stecker (Ferrule Connector) mit Schraubfassung wird wegen seiner Präzision in der Mess- und Prüftechnik bevorzugt.'\n        },\n        {\n          id: 'm4',\n          type: 'true-false',\n          question: 'OM5-Fasern sind abwärtskompatibel mit OM4 und OM3.',\n          answer: true,\n          explanation: 'OM5 ist abwärtskompatibel - kann mit OM3/OM4-Adaptern und -Kabeln verwendet werden.'\n        },\n        {\n          id: 'm5',\n          type: 'multiple-choice',\n          question: 'Was ist die maximale Übertragungsdistanz für OM3 Multimode bei 10Gbit/s?',\n          options: ['100 Meter', '300 Meter', '500 Meter', '2000+ Meter'],\n          correct: 1,\n          explanation: 'OM3 erreicht bei 10Gbit/s bis zu 300m. Bei 100G sind es nur noch 100m.'\n        },\n        {\n          id: 'm6',\n          type: 'true-false',\n          question: 'UPC-Politur hat einen Return Loss von mehr als -60dB.',\n          answer: false,\n          explanation: 'UPC erreicht ca. -50dB Return Loss. APC mit 8° Schrägschliff erreicht >-60dB und ist damit besser.'\n        },\n        {\n          id: 'm7',\n          type: 'multiple-choice',\n          question: 'Welche Wellenlängen werden typischerweise bei Singlemode-Übertragung genutzt?',\n          options: ['650nm (Rot)', '850nm (IR)', '1310nm und 1550nm', '2100nm'],\n          correct: 2,\n          explanation: 'Singlemode arbeitet bei 1310nm und 1550nm - diese Wellenlängen haben geringste Dämpfung in der Glasfaser.'\n        },\n        {\n          id: 'm8',\n          type: 'true-false',\n          question: 'Der SC-APC-Stecker hat eine grüne Kennzeichnung und wird hauptsächlich bei FTTH eingesetzt.',\n          answer: true,\n          explanation: 'Grüne SC-APC-Stecker sind Standard im FTTH/FTTX-Bereich wegen der minimalen Rückflussdämpfung.'\n        },\n        {\n          id: 'm9',\n          type: 'multiple-choice',\n          question: 'Was ist die Hauptvorteil des LC-Duplex gegenüber SC-Duplex?',\n          options: ['Günstigerer Preis', 'Kompaktere Bauform', 'Bessere Dämpfungswerte', 'Einfachere Reinigung'],\n          correct: 1,\n          explanation: 'LC-Duplex ist nur halb so breit wie SC-Duplex - ideal für hohe Portdichten in Switchen.'\n        },\n        {\n          id: 'm10',\n          type: 'true-false',\n          question: 'MT-RJ-Stecker verwenden dieselbe Ferrule-Technologie wie MPO.',\n          answer: true,\n          explanation: 'MT-RJ (Mechanical Transfer - Registered Jack) nutzt MT-Technology mit zwei Faserpositionen in einer Kunststoffhülle.'\n        }\n      ],\n      hard: [\n        {\n          id: 'h1',\n          type: 'multiple-choice',\n          question: 'Welcher LWL-Standard definiert 400G-Übertragung über 2km Singlemode mit MPO-16?',\n          options: ['QSFP-DD', 'OSFP', '400GBASE-DR4 (IEEE 802.3bs)', 'CDWDM16'],\n          correct: 2,\n          explanation: '400GBASE-DR4 nutzt MPO-16 mit 8 Wellenlängen à 50G über 500m-2km (je nach Variante).'\n        },\n        {\n          id: 'h2',\n          type: 'true-false',\n          question: 'Bei MPO-Steckern müssen die Pin-Ausrichtungsnocken (Guide Pins) immer vorhanden sein, unabhängig von der Polarität.',\n          answer: false,\n          explanation: 'Es gibt Varianten mit und ohne Pins. Bei manchen Configurations (Type A/B/C) variiert die Pin-Anordnung für die Polaritätssteuerung.'\n        },\n        {\n          id: 'h3',\n          type: 'multiple-choice',\n          question: 'Was ist der Hauptunterschied zwischen MPO-Type A und Type B?',\n          options: ['Faseranzahl', 'Pin-Ausrichtung (Key)', 'Ferrule-Länge', 'Dämpfungswerte'],\n          correct: 1,\n          explanation: 'Type A hat Key-Up/Key-Down an Position 1. Type B hat Key-Up/Key-Up - wichtig für Polaritätsschaltung.'\n        },\n        {\n          id: 'h4',\n          type: 'true-false',\n          question: 'Beam-Splitter in PON-Netzwerken sind bidirektional und können sowohl 1490nm als auch 1550nm transmitieren.',\n          answer: false,\n          explanation: 'Beam-Splitter sind passiv und brechen das Signal (typisch 1:32 Split). 1490nm Downlink, 1310nm Uplink - unterschiedliche Wellenlängen.'\n        },\n        {\n          id: 'h5',\n          type: 'multiple-choice',\n          question: 'Welche IL-Werte (Insertion Loss) sind typisch für hochwertige Singlemode-Anschlussdosen?',\n          options: ['< 0,3 dB', '< 0,5 dB', '< 1,0 dB', '< 3,0 dB'],\n          correct: 0,\n          explanation: 'Telekom-Grades (< 0,3dB) sind Standard für professionelle Installationen. <=0,5dB für viele Anwendungen akzeptabel.'\n        },\n        {\n          id: 'h6',\n          type: 'true-false',\n          question: 'Polarisation-Maintaining-Fasern (PM-Fasern) verwenden spezielle Steckertypen mit Stress-Rods im Cladding.',\n          answer: true,\n          explanation: 'PM-Fasern haben eingebettete Stress-Rods (Bow-Tie oder Panda) zur Polarisationserhaltung - Stecker müssen exakt ausgerichtet sein.'\n        },\n        {\n          id: 'h7',\n          type: 'multiple-choice',\n          question: 'Bei einem 40GBASE-SR4-Link mit MPO - wie viele der 12 MPO-Faserpositionen werden genutzt?',\n          options: ['4 Fasern', '8 Fasern', '12 Fasern', '24 Fasern'],\n          correct: 2,\n          explanation: 'SR4 nutzt alle 12 Fasern: 4× TX + 4× RX + 4 Reserve/benachbarte Kanäle (manchmal 8 aktiv).'\n        },\n        {\n          id: 'h8',\n          type: 'true-false',\n          question: 'Der PC-Poliertyp (Physical Contact) ist veraltet und wird bei neuen Installationen nicht mehr verwendet.',\n          answer: false,\n          explanation: 'PC wird bei Multimode noch verwendet (OM3/OM4/OM5). UPC (Ultra Physical Contact) ist die verbesserte Version mit besseren Dämpfungswerten.'\n        },\n        {\n          id: 'h9',\n          type: 'multiple-choice',\n          question: 'Was bedeutet \"Key\" bei MPO-Steckern in Bezug auf die Polarität?',\n          options: ['Sicherheitsfeature gegen unbefugtes Stecken', 'Führungsnocken für Faser-Ausrichtung', 'Ferrule-Haltefeder', 'Crimp-Bereich am Kabel'],\n          correct: 1,\n          explanation: 'Der Key ist die Führungsnut/-nocken am Stecker, der die Pin-Ausrichtung bestimmt. Type A: Key-Up an Position 1, Type B: Key-Up/Key-Up.'\n        },\n        {\n          id: 'h10',\n          type: 'true-false',\n          question: 'Singlemode-Pigtails mit APC-Politur können bedenkenlos mit UPC-Patchkabeln kombiniert werden.',\n          answer: false,\n          explanation: 'APC (8°) + UPC (0°) Kontakt verursacht erhöhte Dämpfung und Rückfluss. Niemals APC↔UPC mischen - immer APC↔APC oder UPC↔UPC.'\n        }\n      ]\n    };\n\n    let currentDifficulty = 'easy';\n    let score = { correct: 0, incorrect: 0, total: 0 };\n    let answeredQuestions = new Set();\n\n    function shuffleArray(array) {\n      const shuffled = [...array];\n      for (let i = shuffled.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n      }\n      return shuffled;\n    }\n\n    function createQuizCard(question, index) {\n      const card = document.createElement('div');\n      card.className = 'quiz-card';\n      card.id = `card-${question.id}`;\n\n      if (question.type === 'true-false') {\n        card.innerHTML = `\n          <div class=\"card-header\">\n            <span class=\"badge true-false\">Wahr / Falsch</span>\n            <i data-lucide=\"check-circle\" class=\"card-icon\"></i>\n          </div>\n          <p class=\"question-text\">${index + 1}. ${question.question}</p>\n          <div class=\"true-false-grid\">\n            <button class=\"tf-btn\" data-answer=\"true\" data-id=\"${question.id}\">\n              <i data-lucide=\"check\"></i>\n              <span>Wahr</span>\n            </button>\n            <button class=\"tf-btn\" data-answer=\"false\" data-id=\"${question.id}\">\n              <i data-lucide=\"x\"></i>\n              <span>Falsch</span>\n            </button>\n          </div>\n          <button class=\"check-answer-btn\" data-id=\"${question.id}\" disabled>\n            Antwort prüfen\n          </button>\n          <div class=\"feedback\" id=\"feedback-${question.id}\"></div>\n        `;\n      } else {\n        const optionLabels = ['A', 'B', 'C', 'D'];\n        card.innerHTML = `\n          <div class=\"card-header\">\n            <span class=\"badge multiple-choice\">Multiple Choice</span>\n            <i data-lucide=\"list-checks\" class=\"card-icon\"></i>\n          </div>\n          <p class=\"question-text\">${index + 1}. ${question.question}</p>\n          <div class=\"options\">\n            ${question.options.map((opt, i) => `\n              <button class=\"option-btn\" data-index=\"${i}\" data-id=\"${question.id}\">\n                <span class=\"option-label\">${optionLabels[i]}</span>\n                ${opt}\n              </button>\n            `).join('')}\n          </div>\n          <button class=\"check-answer-btn\" data-id=\"${question.id}\" disabled>\n            Antwort prüfen\n          </button>\n          <div class=\"feedback\" id=\"feedback-${question.id}\"></div>\n        `;\n      }\n\n      return card;\n    }\n\n    function updateProgress() {\n      const totalQuestions = quizData[currentDifficulty].length;\n      const progress = (answeredQuestions.size / totalQuestions) * 100;\n      document.getElementById('progressFill').style.width = `${progress}%`;\n      document.getElementById('scoreDisplay').textContent = `${score.correct} / ${score.total}`;\n      document.getElementById('correctCount').textContent = score.correct;\n      document.getElementById('incorrectCount').textContent = score.incorrect;\n      document.getElementById('totalAnswered').textContent = score.total;\n    }\n\n    function checkAnswer(questionId, selectedAnswer, questionData) {\n      const isCorrect = selectedAnswer === questionData.answer;\n      const feedbackEl = document.getElementById(`feedback-${questionId}`);\n      const checkBtn = document.querySelector(`.check-answer-btn[data-id=\"${questionId}\"]`);\n\n      if (isCorrect) {\n        score.correct++;\n        feedbackEl.className = 'feedback show correct';\n        feedbackEl.innerHTML = `<strong>✓ Richtig!</strong> ${questionData.explanation}`;\n      } else {\n        score.incorrect++;\n        feedbackEl.className = 'feedback show incorrect';\n        const correctText = questionData.type === 'true-false' \n          ? (questionData.answer ? 'Wahr' : 'Falsch')\n          : `${['A', 'B', 'C', 'D'][questionData.answer]}: ${questionData.options[questionData.answer]}`;\n        feedbackEl.innerHTML = `<strong>✗ Leider falsch.</strong> Richtige Antwort: ${correctText}. ${questionData.explanation}`;\n      }\n\n      score.total++;\n      answeredQuestions.add(questionId);\n      checkBtn.disabled = true;\n      updateProgress();\n    }\n\n    function renderQuiz() {\n      const grid = document.getElementById('quizGrid');\n      const questions = shuffleArray(quizData[currentDifficulty]);\n      \n      grid.innerHTML = '';\n      answeredQuestions.clear();\n      \n      questions.forEach((q, index) => {\n        const card = createQuizCard(q, index);\n        grid.appendChild(card);\n      });\n\n      lucide.createIcons();\n      updateProgress();\n\n      // Add event listeners\n      document.querySelectorAll('.tf-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const id = btn.dataset.id;\n          if (answeredQuestions.has(id)) return;\n\n          document.querySelectorAll(`.tf-btn[data-id=\"${id}\"]`).forEach(b => {\n            b.classList.remove('selected-true', 'selected-false');\n          });\n          \n          btn.classList.add(btn.dataset.answer === 'true' ? 'selected-true' : 'selected-false');\n          document.querySelector(`.check-answer-btn[data-id=\"${id}\"]`).disabled = false;\n          \n          btn.dataset.selected = btn.dataset.answer;\n        });\n      });\n\n      document.querySelectorAll('.option-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const id = btn.dataset.id;\n          if (answeredQuestions.has(id)) return;\n\n          document.querySelectorAll(`.option-btn[data-id=\"${id}\"]`).forEach(b => {\n            b.classList.remove('selected');\n          });\n          \n          btn.classList.add('selected');\n          document.querySelector(`.check-answer-btn[data-id=\"${id}\"]`).disabled = false;\n          \n          btn.parentElement.dataset.selected = btn.dataset.index;\n        });\n      });\n\n      document.querySelectorAll('.check-answer-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const id = btn.dataset.id;\n          const question = questions.find(q => q.id === id);\n          \n          if (question.type === 'true-false') {\n            const selectedBtn = document.querySelector(`.tf-btn[data-id=\"${id}\"][data-selected]`);\n            const isCorrect = selectedBtn.dataset.answer === String(question.answer);\n            \n            document.querySelectorAll(`.tf-btn[data-id=\"${id}\"]`).forEach(b => {\n              b.disabled = true;\n              if (b.dataset.answer === String(question.answer)) {\n                b.classList.add('correct');\n              } else if (b === selectedBtn && !isCorrect) {\n                b.classList.add('incorrect');\n              }\n            });\n            \n            checkAnswer(id, selectedBtn.dataset.answer === 'true', question);\n          } else {\n            const selectedBtn = document.querySelector(`.option-btn[data-id=\"${id}\"].selected`);\n            const selectedIndex = parseInt(selectedBtn.dataset.index);\n            \n            document.querySelectorAll(`.option-btn[data-id=\"${id}\"]`).forEach(b => {\n              b.disabled = true;\n              if (parseInt(b.dataset.index) === question.answer) {\n                b.classList.add('correct');\n              } else if (b === selectedBtn && selectedIndex !== question.answer) {\n                b.classList.add('incorrect');\n              }\n            });\n            \n            checkAnswer(id, selectedIndex, question);\n          }\n        });\n      });\n    }\n\n    // Tab switching\n    document.querySelectorAll('.tab-btn').forEach(tab => {\n      tab.addEventListener('click', () => {\n        document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));\n        tab.classList.add('active');\n        currentDifficulty = tab.dataset.difficulty;\n        score = { correct: 0, incorrect: 0, total: 0 };\n        renderQuiz();\n      });\n    });\n\n    // Initialize\n    renderQuiz();\n  </script>\n</body>\n</html>\n",
